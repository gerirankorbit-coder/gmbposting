# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=post-media

# Google OAuth (Business Profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<project>.vercel.app/api/google/callback

# Security
TOKEN_ENCRYPTION_KEY=          # 32 bytes, base64 (openssl rand -base64 32)
OAUTH_STATE_SECRET=            # random string
CRON_SECRET=                   # random string, required header for cron endpoint

# AI
GEMINI_API_KEY=
GEMINI_MODEL=                  # optional; defaults to gemini-flash-latest (always the current Flash model)

# App
APP_URL=https://<project>.vercel.app
DEFAULT_TIMEZONE=Asia/Karachi
IMAGE_LOW_STOCK_THRESHOLD=5

# Optional email notifications
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
NOTIFY_TO_EMAILS=              # comma-separated
